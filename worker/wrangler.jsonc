{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "grid-sync",
	"main": "src/index.js",
	"compatibility_date": "2026-08-06",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// Set to the GitHub Pages origin Grid is served from (no trailing slash).
	// Comma-separated if a second origin is ever added.
	"vars": {
		"ALLOWED_ORIGIN": "https://galvarez171.github.io",
		// Raw uncompressed P-256 public key, base64url — same value goes in the
		// app as the PushManager.subscribe() applicationServerKey. Not secret.
		"VAPID_PUBLIC_KEY": "BPirvr7mJvbF3jy-S0znrnX9fkiv_ejnj0AhXn150GDYI3Gv9cbMZq95k8w5ZSsVvdBt9-14k_iXynEQg0IDhe8",
		// Push services want a contact URI in case they need to reach the sender.
		"VAPID_SUBJECT": "mailto:gabealvarez1@icloud.com",
		"TIMEZONE": "America/Chicago"
	},
	// No "id" on purpose: wrangler provisions the namespace on first deploy and
	// writes the id back here. GRID_TOKEN is a secret, set with `wrangler secret
	// put` — it never appears in this file.
	"kv_namespaces": [
		{
			"binding": "GRID_KV",
			"id": "32aec2d481754f109643f7cd65273c2a"
		}
	],
	"triggers": { "crons": ["*/30 * * * *"] }
}